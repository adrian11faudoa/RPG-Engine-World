{
  "name": "realmforge-dashboard",
  "version": "1.0.0",
  "description": "RealmForge Engine Web Dashboard API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "build": "echo 'API-only \u2014 no bundler step needed'",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit --runInBand",
    "test:ci": "node --experimental-vm-modules node_modules/.bin/jest --forceExit --runInBand --coverage",
    "lint": "eslint src --ext .js",
    "migrate": "node src/db/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-gamelift": "^3.450.0",
    "@aws-sdk/client-s3": "^3.450.0",
    "@aws-sdk/s3-request-presigner": "^3.450.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "multer": "^1.4.5-lts.1",
    "adm-zip": "^0.5.10"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "extensionsToTreatAsEsm": [
      ".js"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/__tests__/**"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}